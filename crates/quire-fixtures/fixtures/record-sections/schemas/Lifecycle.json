{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/quire-fixtures/0.1.0/Lifecycle.json",
  "$comment": "Synthetic fixture root for the record-sections cases; not a module schema.",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "draft",
        "accepted",
        "rejected"
      ]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "string"
        },
        "likelihood": {
          "type": "string"
        },
        "exposure": {
          "type": "string"
        },
        "controllability": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "assertedBy": {
          "type": "string"
        },
        "assertedAt": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "signature": {
          "$ref": "https://schemas.agent-ix.org/agent-ix/quire-fixtures/0.1.0/Signature.json"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/quire-fixtures/0.1.0/Evidence.json"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.0/SemanticId.json"
      }
    },
    "retryPolicy": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer"
        },
        "backoff": {
          "type": "string"
        }
      },
      "unevaluatedProperties": {
        "not": {}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "required": [
          "provenance"
        ]
      }
    }
  ],
  "unevaluatedProperties": {
    "not": {}
  }
}
