 /// Raw `ix://` URIs found in the document body.
 fn harvest_body_links(doc: &LoadedDocument, re: &Regex) -> Vec<String> {
     re.find_iter(doc.raw())
         .map(|m| m.as_str().to_string())
         .collect()
 }
