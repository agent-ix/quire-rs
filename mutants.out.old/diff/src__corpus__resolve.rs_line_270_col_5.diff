 fn ix_link_regex() -> Regex {
     // Match an ix:// URI up to whitespace or a closing delimiter so it
     // works for `[t](ix://…)`, `<ix://…>`, and bare occurrences.
     Regex::new(r#"ix://[^\s)\]>"']+"#).expect("static ix-link regex is valid")
 }
 
