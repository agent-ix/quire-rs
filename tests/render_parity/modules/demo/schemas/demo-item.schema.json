{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEMO-[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "body": {
      "type": "string",
      "default": ""
    }
  }
}
