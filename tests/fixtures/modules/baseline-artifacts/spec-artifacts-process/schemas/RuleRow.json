{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/RuleRow.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/RuleId.json"
    },
    "rule": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the rule statement."
    },
    "objective": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the objective id as authored."
    },
    "class": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the failure class the rule guards against."
    },
    "source": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the incident or source the rule came from."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/LineNumber.json"
    }
  },
  "required": [
    "id",
    "rule",
    "objective",
    "class",
    "source",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `## Rules` row: a required or forbidden behavior, the objective it serves and the incident it came from."
}
