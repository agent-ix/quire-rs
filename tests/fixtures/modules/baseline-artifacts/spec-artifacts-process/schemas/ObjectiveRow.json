{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/ObjectiveRow.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/ObjectiveId.json"
    },
    "objective": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the objective."
    },
    "metrics": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the metric ids as authored; whether each resolves is a reference diagnostic."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/LineNumber.json"
    }
  },
  "required": [
    "id",
    "objective",
    "metrics",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `## Objectives` row: what the role is for and the metrics that show it."
}
