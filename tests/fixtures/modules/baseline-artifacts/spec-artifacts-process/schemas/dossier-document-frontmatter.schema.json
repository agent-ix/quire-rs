{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "type", "document_kind", "generated_by", "producer_identity"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "DossierDocument"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "document_kind": {
      "enum": ["srs", "architecture", "trace-matrix", "rmm", "verification-report", "soup", "anomalies", "risk-management", "risk-management-plan", "release-record", "threat-model", "records-of-processing", "vulnerability-management-plan"]
    },
    "generated_by": {
      "const": "quoin dossier"
    },
    "producer_identity": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "quoin"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)([.][0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "object": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "type"],
        "additionalProperties": false,
        "properties": {
          "target": { "type": "string", "pattern": "^ix://" },
          "type": { "type": "string" },
          "cardinality": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "document_kind": { "const": "rmm" } },
        "required": ["document_kind"]
      },
      "then": { "required": ["as_of"] }
    },
    {
      "if": {
        "properties": {
          "document_kind": { "not": { "const": "records-of-processing" } }
        },
        "required": ["document_kind"]
      },
      "then": { "required": ["version"] }
    }
  ]
}
