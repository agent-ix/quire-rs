{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/RubricCheckRow.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/RubricCheckRef.json"
    },
    "check": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: what the check asks."
    },
    "scale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/NonEmptyText.json",
      "description": "free text: the scoring scale."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-process/LineNumber.json"
    }
  },
  "required": [
    "id",
    "check",
    "scale",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `## Checks` row of a rubric: a versioned check id, what it asks and its scale."
}
