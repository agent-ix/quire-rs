{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "scope",
    "rating",
    "status",
    "relationships"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^FRR-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "FeatureRiskRating"},
    "scope": {"enum": ["supplier", "adopter"]},
    "rating": {"enum": ["high_process_risk", "not_high_process_risk"]},
    "status": {"enum": ["proposed", "accepted"]},
    "rated_by": {"type": "string", "minLength": 1},
    "intended_use": {"type": "string", "minLength": 1},
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target", "type"],
        "additionalProperties": false,
        "properties": {
          "target": {"type": "string", "pattern": "^ix://"},
          "type": {"enum": ["rates_feature", "re_rates", "uses_intended_use"]},
          "cardinality": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "proposed"}}},
      "then": {"not": {"required": ["rated_by"]}}
    },
    {
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {"required": ["rated_by"]}
    },
    {
      "if": {"properties": {"scope": {"const": "supplier"}}},
      "then": {
        "not": {"required": ["intended_use"]},
        "properties": {
          "relationships": {
            "allOf": [
              {"contains": {"properties": {"type": {"const": "rates_feature"}}, "required": ["type"]}},
              {"contains": {"properties": {"type": {"const": "uses_intended_use"}, "target": {"pattern": "^ix://[^/]+/[^/]+/IU-[0-9]{3}$"}}, "required": ["type", "target"]}, "minContains": 1, "maxContains": 1},
              {"not": {"contains": {"properties": {"type": {"const": "re_rates"}}, "required": ["type"]}}}]
          }
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "adopter"}}},
      "then": {
        "required": ["intended_use"],
        "properties": {
          "relationships": {
            "contains": {"properties": {"type": {"const": "re_rates"}}, "required": ["type"]},
            "not": {"anyOf": [
              {"contains": {"properties": {"type": {"const": "rates_feature"}}, "required": ["type"]}},
              {"contains": {"properties": {"type": {"const": "uses_intended_use"}}, "required": ["type"]}}
            ]}
          }
        }
      }
    }
  ]
}
