{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "type"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "pattern": "^FR-[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"const": "FR"}
  }
}
