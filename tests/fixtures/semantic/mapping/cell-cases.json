{
  "$comment": "FR-071 cell and fence-line grammar cases (AC-4..AC-8): first-party, owned by quire-rs. Each case gives one cell (or fence line) and the expected TypeRef/constraint fragment or diagnostic.",
  "semanticCore": "0.1.0",
  "package": "agent-ix/config-service",
  "cases": [
    {
      "id": "type-kernel",
      "cell": {
        "Type": "Timestamp"
      },
      "expected": {
        "target": "Timestamp"
      }
    },
    {
      "id": "type-decimal",
      "cell": {
        "Type": "Decimal(12,3)"
      },
      "expected": {
        "target": "Decimal",
        "decimal": {
          "precision": 12,
          "scale": 3
        }
      }
    },
    {
      "id": "type-unit",
      "cell": {
        "Type": "Duration [s]"
      },
      "expected": {
        "target": "Duration",
        "unit": "s"
      }
    },
    {
      "id": "type-object-by-title",
      "cell": {
        "Type": "ConfigOverlay"
      },
      "bundle": {
        "objects": [
          {
            "id": "FR-005",
            "title": "ConfigOverlay"
          }
        ]
      },
      "expected": {
        "target": "ix://agent-ix/config-service/type/ConfigOverlay"
      }
    },
    {
      "id": "type-enum-by-id",
      "cell": {
        "Type": "OverlayState"
      },
      "bundle": {
        "enumerations": [
          {
            "id": "OverlayState",
            "title": "Overlay State Values"
          }
        ]
      },
      "expected": {
        "target": "ix://agent-ix/config-service/type/OverlayState"
      }
    },
    {
      "id": "type-import",
      "cell": {
        "Type": "LexiconTerm"
      },
      "imports": {
        "agent-ix/lexicon-core": {
          "exports": [
            "LexiconTerm"
          ]
        }
      },
      "expected": {
        "target": "ix://agent-ix/lexicon-core/type/LexiconTerm"
      }
    },
    {
      "id": "type-unresolved",
      "cell": {
        "Type": "Enigma"
      },
      "expected": {
        "target": "ix://agent-ix/config-service/unresolved/Enigma"
      },
      "diagnostics": [
        {
          "code": "semantic.unresolved-type",
          "severity": "advisory",
          "locus": "row"
        }
      ]
    },
    {
      "id": "mult-one",
      "cell": {
        "Multiplicity": "1"
      },
      "expected": {
        "multiplicity": {
          "lower": 1,
          "upper": 1
        }
      }
    },
    {
      "id": "mult-optional",
      "cell": {
        "Multiplicity": "0..1"
      },
      "expected": {
        "multiplicity": {
          "lower": 0,
          "upper": 1
        }
      }
    },
    {
      "id": "mult-many-flags",
      "cell": {
        "Multiplicity": "1..* ordered unique"
      },
      "expected": {
        "multiplicity": {
          "lower": 1,
          "ordered": true,
          "unique": true
        }
      }
    },
    {
      "id": "mult-range",
      "cell": {
        "Multiplicity": "3..7"
      },
      "expected": {
        "multiplicity": {
          "lower": 3,
          "upper": 7
        }
      }
    },
    {
      "id": "mult-empty",
      "cell": {
        "Multiplicity": ""
      },
      "expected": {
        "multiplicity": {
          "lower": 1,
          "upper": 1
        }
      }
    },
    {
      "id": "mult-inverted",
      "cell": {
        "Multiplicity": "6..3"
      },
      "diagnostics": [
        {
          "code": "semantic.invalid-multiplicity",
          "severity": "error",
          "locus": "row"
        }
      ]
    },
    {
      "id": "mult-flag-on-single",
      "cell": {
        "Multiplicity": "1 unique"
      },
      "diagnostics": [
        {
          "code": "semantic.invalid-multiplicity",
          "severity": "error",
          "locus": "row"
        }
      ]
    },
    {
      "id": "con-min-maxlen-identity",
      "cell": {
        "Constraints": "min: 0, maxLength: 32, identity"
      },
      "expected": {
        "constraints": [
          {
            "keyword": "min",
            "value": 0
          },
          {
            "keyword": "maxLength",
            "value": 32
          }
        ],
        "identity": true
      }
    },
    {
      "id": "con-pattern",
      "cell": {
        "Constraints": "pattern: /^[A-Z0-9]+$/"
      },
      "expected": {
        "constraints": [
          {
            "keyword": "pattern",
            "regex": "^[A-Z0-9]+$",
            "dialect": "ecma-262"
          }
        ]
      }
    },
    {
      "id": "con-enum-values",
      "cell": {
        "Constraints": "enumValues: pending|applied|superseded"
      },
      "expected": {
        "constraints": [
          {
            "keyword": "enumValues",
            "values": [
              "pending",
              "applied",
              "superseded"
            ]
          }
        ]
      }
    },
    {
      "id": "con-non-empty",
      "cell": {
        "Constraints": "nonEmpty"
      },
      "expected": {
        "constraints": [
          {
            "keyword": "nonEmpty"
          }
        ]
      }
    },
    {
      "id": "con-format",
      "cell": {
        "Constraints": "format: agent-ix:actor-id"
      },
      "expected": {
        "constraints": [
          {
            "keyword": "format",
            "name": "agent-ix:actor-id"
          }
        ]
      }
    },
    {
      "id": "con-unknown-keyword",
      "cell": {
        "Constraints": "maximun: 1"
      },
      "diagnostics": [
        {
          "code": "semantic.unknown-constraint-keyword",
          "severity": "error",
          "locus": "row"
        }
      ]
    },
    {
      "id": "fence-item",
      "fenceLine": "item x : Y;",
      "diagnostics": [
        {
          "code": "semantic.sysml-outside-subset",
          "severity": "error",
          "locus": "fence-line"
        }
      ]
    },
    {
      "id": "fence-part-def",
      "fenceLine": "part def X;",
      "diagnostics": [
        {
          "code": "semantic.sysml-outside-subset",
          "severity": "error",
          "locus": "fence-line"
        }
      ]
    },
    {
      "id": "fence-specializes",
      "fenceLine": ":> Y",
      "diagnostics": [
        {
          "code": "semantic.sysml-outside-subset",
          "severity": "error",
          "locus": "fence-line"
        }
      ]
    },
    {
      "id": "reader-rule-bare-decimal",
      "cell": {
        "Type": "Decimal"
      },
      "diagnostics": [
        {
          "code": "agent-ix.semantic-core.MISSING_DECIMAL_POLICY",
          "severity": "error",
          "locus": "row"
        }
      ]
    }
  ]
}
