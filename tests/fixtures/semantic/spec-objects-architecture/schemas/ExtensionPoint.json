{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/ExtensionPoint.json",
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/OperationDecl.json"
      },
      "minItems": 1
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/ClauseRef.json"
      },
      "minItems": 1
    },
    "exposes": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/SemanticId.json"
    },
    "registration": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/RegistrationPolicy.json"
    },
    "stability": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/StabilityPolicy.json"
    }
  },
  "required": [
    "operations",
    "clauses"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Pluggability as a first-class node: the operations third-party implementers\nwrite against, plus the stability guarantee they rely on. `fields` and\n`relations` are forbidden by the seal."
}
