{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/RecordLayout.json",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/Identifier.json"
    },
    "tag": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/LayoutField.json"
      },
      "minItems": 1
    }
  },
  "required": [
    "name",
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One record type of a persisted binary layout."
}
