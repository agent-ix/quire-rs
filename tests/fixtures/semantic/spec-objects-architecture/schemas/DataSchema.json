{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/DataSchema.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/FieldDecl.json"
      },
      "minItems": 1
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/ClauseRef.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/RelationDecl.json"
      }
    }
  },
  "required": [
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A record shape other objects reference by `TypeRef`. It declares data, not\nbehaviour: `operations` is forbidden by the seal."
}
