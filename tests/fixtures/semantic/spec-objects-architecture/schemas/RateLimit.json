{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/RateLimit.json",
  "type": "object",
  "properties": {
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/ClauseRef.json"
      },
      "minItems": 1
    },
    "thresholds": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-architecture/0.4.0/Threshold.json"
      }
    },
    "throttles": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/SemanticId.json"
      }
    }
  },
  "required": [
    "clauses"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A throttling policy. It exists to pin what happens at the limit, so it\ncarries at least one clause; `fields` and `operations` are forbidden by the\nseal."
}
